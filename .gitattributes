# Store every file byte-for-byte. The freeze manifest and the locked dataset are
# verified by SHA-256, so line endings must never be converted on checkout.
* -text

*.pdf   binary
*.png   binary
*.jpg   binary
*.docx  binary

# Generated files: keep them out of the language statistics and collapse them in diffs
03_pipeline/analysis_notebook.ipynb  linguist-generated=true
02_data/*.jsonl                      linguist-generated=true
02_data/responses_locked.csv         linguist-generated=true
04_results/*.csv                     linguist-generated=true
04_results/summary.json              linguist-generated=true
07_guide/**                          linguist-documentation=true
